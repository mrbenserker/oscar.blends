{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/manage",
      "destination": "/manage.html"
    },
    {
      "source": "/manage/",
      "destination": "/manage.html"
    },
    {
      "source": "/compte",
      "destination": "/compte.html"
    },
    {
      "source": "/compte/",
      "destination": "/compte.html"
    }
  ],
  "functions": {
    "api/appointment-action.js": {
      "maxDuration": 10
    },
    "api/public-config.js": {
      "maxDuration": 10
    },
    "api/manage-appointment.js": {
      "maxDuration": 10
    },
    "api/automation.js": {
      "maxDuration": 30
    },
    "api/email-test.js": {
      "maxDuration": 10
    },
    "api/account-login.js": {
      "maxDuration": 10
    },
    "api/account-auth.js": {
      "maxDuration": 10
    },
    "api/account-me.js": {
      "maxDuration": 10
    },
    "api/account-logout.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/automation",
      "schedule": "0 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/compte",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/compte/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/compte.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/compte.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/api/account-login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/account-auth",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/account-me",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/account-logout",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
